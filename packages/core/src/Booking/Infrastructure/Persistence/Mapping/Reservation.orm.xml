<?xml version="1.0" encoding="UTF-8"?>
<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping https://www.doctrine-project.org/schemas/orm/doctrine-mapping.xsd">
    <!-- Adresse en clair pour l'instant : chiffrement prévu (docs/securite.md). -->
    <entity name="Bsandoz\Core\Booking\Domain\Model\Reservation" table="reservation">
        <indexes>
            <index name="idx_reservation_period" columns="period_start,period_end"/>
            <index name="idx_reservation_user" columns="user_id"/>
        </indexes>
        <id name="id" type="string" length="36"/>
        <field name="userId" column="user_id" type="string" length="36"/>
        <field name="prestationId" column="prestation_id" type="string" length="36"/>
        <field name="variante" type="string" length="60" nullable="true"/>
        <field name="optionIds" column="option_ids" type="json"/>
        <embedded name="period" class="Bsandoz\Core\Shared\Domain\TimeRange" column-prefix="period_"/>
        <field name="address" type="text"/>
        <field name="lat" type="float"/>
        <field name="lng" type="float"/>
        <field name="total" column="total_cents" type="bsandoz_money"/>
        <field name="deposit" column="deposit_cents" type="bsandoz_money"/>
        <field name="travelFee" column="travel_fee_cents" type="bsandoz_money"/>
        <field name="metierData" column="metier_data" type="json"/>
        <field name="notes" type="text"/>
        <field name="status" type="string" length="20" enum-type="Bsandoz\Core\Booking\Domain\Model\ReservationStatus"/>
        <field name="holdExpiresAt" column="hold_expires_at" type="datetime_utc_immutable" nullable="true"/>
    </entity>
</doctrine-mapping>
