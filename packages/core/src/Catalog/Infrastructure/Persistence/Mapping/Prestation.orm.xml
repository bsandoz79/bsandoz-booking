<?xml version="1.0" encoding="UTF-8"?>
<!-- Mapping XML : le domaine reste sans attributs Doctrine. Tarifs et options autorisées en colonnes JSON. -->
<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping https://www.doctrine-project.org/schemas/orm/doctrine-mapping.xsd">
    <entity name="Bsandoz\Core\Catalog\Domain\Model\Prestation" table="prestation">
        <indexes>
            <index name="idx_prestation_active_position" columns="active,position"/>
        </indexes>
        <id name="id" type="string" length="36"/>
        <field name="name" type="string" length="120"/>
        <field name="description" type="text"/>
        <field name="basePrice" column="base_price_cents" type="bsandoz_money"/>
        <field name="baseDurationMin" column="base_duration_min" type="integer"/>
        <field name="active" type="boolean"/>
        <field name="categoryId" column="category_id" type="string" length="36" nullable="true"/>
        <field name="position" type="integer"/>
        <field name="occupePlage" column="occupe_plage" type="boolean"/>
        <field name="badge" type="string" length="40" nullable="true"/>
        <field name="tarifs" type="bsandoz_tarifs"/>
        <field name="optionIds" column="option_ids" type="json"/>
    </entity>
</doctrine-mapping>
