<?xml version="1.0" encoding="UTF-8"?>
<!-- Articles de la carte (module Carte). -->
<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping https://www.doctrine-project.org/schemas/orm/doctrine-mapping.xsd">
    <entity name="Bsandoz\Core\Carte\Domain\Model\Article" table="carte_article">
        <id name="id" type="string" length="36"/>
        <field name="categorieId" column="category_id" type="string" length="36"/>
        <field name="nom" column="name" type="string" length="120"/>
        <field name="description" type="text"/>
        <field name="prix" column="price_cents" type="bsandoz_money"/>
        <field name="ancienPrixCents" column="old_price_cents" type="integer" nullable="true"/>
        <field name="prixChangeLe" column="price_changed_at" type="datetime_immutable" nullable="true"/>
        <field name="creeLe" column="created_at" type="datetime_immutable"/>
        <field name="epuiseJusquA" column="sold_out_until" type="datetime_immutable" nullable="true"/>
        <field name="position" type="integer"/>
        <field name="visible" type="boolean"/>
        <field name="photo" type="string" length="255" nullable="true"/>
    </entity>
</doctrine-mapping>
