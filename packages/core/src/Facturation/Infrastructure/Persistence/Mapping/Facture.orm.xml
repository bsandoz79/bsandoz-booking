<?xml version="1.0" encoding="UTF-8"?>
<!-- Factures émises : numéro unique, une par réservation, vendeur / client / lignes figés en JSON. -->
<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping https://www.doctrine-project.org/schemas/orm/doctrine-mapping.xsd">
    <entity name="Bsandoz\Core\Facturation\Domain\Model\Facture" table="invoice">
        <unique-constraints>
            <unique-constraint name="uniq_invoice_number" columns="number"/>
            <unique-constraint name="uniq_invoice_reservation" columns="reservation_id"/>
        </unique-constraints>
        <indexes>
            <index name="idx_invoice_user" columns="user_id"/>
        </indexes>
        <id name="id" type="string" length="36"/>
        <field name="numero" column="number" type="string" length="20"/>
        <field name="reservationId" column="reservation_id" type="string" length="36"/>
        <field name="userId" column="user_id" type="string" length="36"/>
        <field name="emiseLe" column="issued_at" type="datetime_utc_immutable"/>
        <field name="prestationLe" column="service_at" type="datetime_utc_immutable"/>
        <field name="vendeur" column="seller" type="json"/>
        <field name="client" column="customer" type="json"/>
        <field name="lignes" column="lines" type="json"/>
        <field name="total" column="total_cents" type="bsandoz_money"/>
        <field name="payeEnLigne" column="paid_online_cents" type="bsandoz_money"/>
    </entity>
</doctrine-mapping>
