{
    "name": "bsandoz/core",
    "description": "Kit de réservation réutilisable : Auth, Catalog, Booking, Payment, Notification, Admin.",
    "type": "symfony-bundle",
    "license": "proprietary",
    "require": {
        "php": ">=8.3",
        "symfony/framework-bundle": "^7.3",
        "symfony/security-bundle": "^7.3",
        "symfony/validator": "^7.3",
        "symfony/serializer": "^7.3",
        "symfony/mailer": "^7.3",
        "symfony/rate-limiter": "^7.3",
        "symfony/uid": "^7.3",
        "symfony/http-client": "^7.3",
        "doctrine/orm": "^3.3",
        "doctrine/doctrine-bundle": "^2.13",
        "lexik/jwt-authentication-bundle": "^3.1",
        "stripe/stripe-php": "^16.0",
        "twig/twig": "^3.14"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5",
        "phpstan/phpstan": "^2.1"
    },
    "autoload": { "psr-4": { "Bsandoz\\Core\\": "src/" } },
    "autoload-dev": { "psr-4": { "Bsandoz\\Core\\Tests\\": "tests/" } },
    "scripts": {
        "test": "phpunit",
        "stan": "phpstan analyse --no-progress"
    },
    "config": { "sort-packages": true }
}
