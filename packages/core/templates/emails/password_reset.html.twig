{% extends '_base.html.twig' %}
{% import '_macros.html.twig' as m %}
{% block subject %}Changement de votre mot de passe{% endblock %}
{% block preheader %}Lien valable 1 heure.{% endblock %}
{% block titre %}Choisissez un nouveau mot de passe{% endblock %}
{% block body %}
<p style="margin:0 0 8px;">Bonjour {{ firstname }},</p>
<p style="margin:0;">Vous avez demandé à changer votre mot de passe.</p>
{{ m.bouton(front_url ~ '/compte/mot-de-passe?jeton=' ~ token, 'Choisir un nouveau mot de passe') }}
<p style="margin:0;font-size:14px;color:#4b5563;">Ce lien est valable 1 heure. Vous n’êtes pas à l’origine de cette demande ? Ignorez ce message : votre mot de passe reste inchangé.</p>
{% endblock %}
