{% extends '_base.html.twig' %}
{% import '_macros.html.twig' as m %}
{% block subject %}Créez votre mot de passe{% endblock %}
{% block body %}
<p>Bonjour {{ firstname }},</p>
<p>Un compte a été créé pour vous lors de votre réservation. Choisissez votre mot de passe pour suivre vos rendez-vous en ligne.</p>
{{ m.bouton(front_url ~ '/compte/activer?jeton=' ~ token, 'Créer mon mot de passe') }}
<p>Ce lien est valable 7 jours.</p>
{% endblock %}
