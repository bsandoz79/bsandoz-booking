{% extends '_base.html.twig' %}
{% import '_macros.html.twig' as m %}
{% block subject %}Rappel : votre rendez-vous de demain{% endblock %}
{% block body %}
<p>Bonjour {{ firstname }},</p>
<p>Petit rappel : votre rendez-vous a lieu demain, le <strong>{{ m.date(start, timezone) }}</strong>.</p>
{% if address is defined and address %}<p>Adresse : {{ address }}</p>{% endif %}
{% if manageToken is defined and manageToken %}{{ m.bouton(front_url ~ '/rendez-vous?jeton=' ~ manageToken, 'Voir mon rendez-vous') }}{% endif %}
{% endblock %}
