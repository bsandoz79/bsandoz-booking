{# Bouton (compatible avec tous les logiciels de messagerie), avec le lien en clair dessous si le bouton ne s'affiche pas. #}
{% macro bouton(url, libelle, secondaire) %}
    <table role="presentation" cellpadding="0" cellspacing="0" style="margin:24px 0 8px;"><tr>
        <td style="border-radius:10px;background:{{ secondaire ? '#ffffff' : '#1673d1' }};{{ secondaire ? 'border:1.5px solid #1673d1;' : '' }}">
            <a href="{{ url }}" style="display:inline-block;padding:13px 24px;font-size:16px;font-weight:700;color:{{ secondaire ? '#1673d1' : '#ffffff' }};text-decoration:none;border-radius:10px;">{{ libelle }}</a>
        </td>
    </tr></table>
    {% if not secondaire %}<p style="margin:0 0 16px;font-size:12px;line-height:1.5;color:#9ca3af;">Le bouton ne s’affiche pas ? Copiez ce lien : <span style="color:#6b7280;word-break:break-all;">{{ url }}</span></p>{% endif %}
{% endmacro %}

{# Encadré récapitulatif : lignes [intitulé, valeur] ; les valeurs vides sont ignorées. #}
{% macro recap(lignes) %}
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="margin:18px 0;background:#f4f7fb;border:1px solid #e1e8f0;border-radius:12px;">
        {% for ligne in lignes %}{% if ligne[1] %}
        <tr>
            <td style="padding:10px 16px;{{ not loop.first ? 'border-top:1px solid #e1e8f0;' : '' }}font-size:13px;color:#6b7280;width:38%;vertical-align:top;">{{ ligne[0] }}</td>
            <td style="padding:10px 16px;{{ not loop.first ? 'border-top:1px solid #e1e8f0;' : '' }}font-size:15px;color:#0f1b2d;font-weight:600;vertical-align:top;">{{ ligne[1] }}</td>
        </tr>
        {% endif %}{% endfor %}
    </table>
{% endmacro %}

{# Note discrète (bandeau d'information). #}
{% macro note(texte) %}
    <p style="margin:16px 0;padding:12px 16px;background:#fff8e6;border-radius:10px;font-size:14px;color:#5c4300;">{{ texte }}</p>
{% endmacro %}

{# Date et heure locales, ex. « 10/11/2026 à 09h00 » (conservé pour les modèles personnalisés). #}
{% macro date(iso, timezone) %}{{ iso|date('d/m/Y', timezone) }} à {{ iso|date('H', timezone) }}h{{ iso|date('i', timezone) }}{% endmacro %}
