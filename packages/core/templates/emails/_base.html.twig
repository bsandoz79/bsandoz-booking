{# Mise en page commune des mails. Variables globales : brand, front_url, timezone. #}
<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{ block('subject') }}</title>
</head>
<body style="margin:0;padding:0;background:#f4f6f8;font-family:Arial,Helvetica,sans-serif;color:#1f2933;">
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:#f4f6f8;padding:24px 0;">
        <tr><td align="center">
            <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="max-width:560px;background:#ffffff;border-radius:8px;padding:32px;">
                <tr><td style="font-size:20px;font-weight:bold;padding-bottom:16px;">{{ brand }}</td></tr>
                <tr><td style="font-size:16px;line-height:1.5;">
                    {% block body %}{% endblock %}
                </td></tr>
                <tr><td style="font-size:13px;color:#6b7280;padding-top:24px;border-top:1px solid #e5e7eb;">
                    Ce message vous est envoyé par {{ brand }}. Merci de ne pas y répondre directement.
                </td></tr>
            </table>
        </td></tr>
    </table>
</body>
</html>
