{# Mise en page commune des mails : en-tête (logo et nom), titre, contenu, pied de page.
   Variables globales : brand, front_url, timezone, logo_url, contact_email.
   Blocs : subject (objet), preheader (aperçu dans la boîte mail, objet par défaut), titre (grand titre, aucun par défaut), body.
   Tableaux et styles en ligne : rendu fidèle dans Gmail, Outlook et les applications mobiles. #}
<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="color-scheme" content="light">
    <title>{{ block('subject') }}</title>
</head>
<body style="margin:0;padding:0;background:#eef1f5;font-family:'Segoe UI',Roboto,Helvetica,Arial,sans-serif;color:#1f2933;-webkit-text-size-adjust:100%;">
    <div style="display:none;max-height:0;overflow:hidden;opacity:0;color:#eef1f5;">{% block preheader %}{{ block('subject') }}{% endblock %}</div>
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:#eef1f5;padding:28px 12px;">
        <tr><td align="center">
            <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="max-width:600px;">
                {# En-tête : logo et nom, liseré de couleur. #}
                <tr><td style="background:#ffffff;border-radius:14px 14px 0 0;border-bottom:3px solid #1673d1;padding:20px 32px;">
                    <table role="presentation" cellpadding="0" cellspacing="0"><tr>
                        {% if logo_url %}<td style="padding-right:12px;vertical-align:middle;"><img src="{{ logo_url }}" alt="" width="48" height="42" style="display:block;border:0;height:42px;width:auto;"></td>{% endif %}
                        <td style="vertical-align:middle;font-size:19px;font-weight:700;color:#0f1b2d;">{{ brand }}</td>
                    </tr></table>
                </td></tr>
                {# Contenu. #}
                <tr><td style="background:#ffffff;padding:32px;font-size:16px;line-height:1.6;">
                    {% set titre = block('titre') is defined ? block('titre')|trim : '' %}
                    {% if titre %}<h1 style="margin:0 0 18px;font-size:22px;line-height:1.3;color:#0f1b2d;">{{ titre }}</h1>{% endif %}
                    {% block body %}{% endblock %}
                </td></tr>
                {# Pied de page. #}
                <tr><td style="background:#f8fafc;border-radius:0 0 14px 14px;border-top:1px solid #e5e7eb;padding:20px 32px;font-size:13px;line-height:1.6;color:#6b7280;">
                    <strong style="color:#374151;">{{ brand }}</strong>{% if front_url %} · <a href="{{ front_url }}" style="color:#1673d1;text-decoration:none;">{{ front_url|replace({'https://': '', 'http://': ''}) }}</a>{% endif %}<br>
                    {% if contact_email %}Une question ? Répondez simplement à cet e-mail{% else %}Ce message est envoyé automatiquement, merci de ne pas y répondre{% endif %}.
                    {% block pied %}{% endblock %}
                </td></tr>
            </table>
        </td></tr>
    </table>
</body>
</html>
