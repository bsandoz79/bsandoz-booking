{% extends '_base.html.twig' %}
{% import '_macros.html.twig' as m %}
{% block subject %}Votre rendez-vous a été déplacé{% endblock %}
{% block body %}
<p>Bonjour {{ firstname }},</p>
<p>Votre rendez-vous est désormais prévu le <strong>{{ m.date(start, timezone) }}</strong>.</p>
<p>Le rendez-vous mis à jour est joint à ce message pour votre agenda.</p>
{% endblock %}
