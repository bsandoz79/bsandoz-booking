{% extends '_base.html.twig' %}
{% import '_macros.html.twig' as m %}
{% block subject %}Rendez-vous déplacé au {{ start|jour_long }}{% endblock %}
{% block preheader %}Nouvelle date : {{ start|date_longue }}.{% endblock %}
{% block titre %}Votre rendez-vous a été déplacé{% endblock %}
{% block body %}
<p style="margin:0 0 8px;">Bonjour {{ firstname }},</p>
<p style="margin:0;">C’est noté, voici la nouvelle date :</p>
{{ m.recap([['Nouvelle date', start|date_longue], ['Ancienne date', previousStart is defined ? previousStart|date_longue : ''], ['Prestation', prestation ?? ''], ['Adresse', address ?? '']]) }}
<p style="margin:0;font-size:14px;color:#4b5563;">L’invitation jointe met votre agenda à jour.</p>
{% endblock %}
