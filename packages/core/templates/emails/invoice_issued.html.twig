{% extends '_base.html.twig' %}
{% import '_macros.html.twig' as m %}
{% block subject %}Votre facture {{ numero }}{% endblock %}
{% block preheader %}Merci pour votre confiance ! Facture {{ numero }} : {{ totalCents|euros }}.{% endblock %}
{% block titre %}Merci pour votre confiance !{% endblock %}
{% block body %}
<p style="margin:0 0 8px;">Bonjour {{ firstname }},</p>
<p style="margin:0;">La prestation est terminée, voici votre facture :</p>
{{ m.recap([['Facture', numero], ['Montant', totalCents|euros]]) }}
{{ m.bouton(front_url ~ '/facture/' ~ factureId, 'Voir ma facture') }}
<p style="margin:0;font-size:14px;color:#4b5563;">Vous la retrouvez à tout moment dans votre espace client, d’où vous pouvez l’enregistrer en PDF.</p>
{% if avisUrl is defined and avisUrl %}
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="margin:24px 0 0;border-top:1px solid #e5e7eb;"><tr><td style="padding-top:20px;">
<p style="margin:0;font-size:16px;"><strong>Satisfait du résultat ?</strong></p>
<p style="margin:4px 0 0;font-size:14px;color:#4b5563;">Votre avis aide beaucoup un artisan indépendant : il ne prend qu’une minute.</p>
{{ m.bouton(avisUrl, 'Laisser un avis', true) }}
</td></tr></table>
{% endif %}
{% endblock %}
