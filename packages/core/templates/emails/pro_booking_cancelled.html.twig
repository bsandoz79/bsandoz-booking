{% extends '_base.html.twig' %}
{% import '_macros.html.twig' as m %}
{% block subject %}Rendez-vous annulé : {{ client }}, {{ start|jour_long }}{% endblock %}
{% block titre %}Rendez-vous annulé{% endblock %}
{% block body %}
<p style="margin:0;">{{ client }} a annulé son rendez-vous. Le créneau est de nouveau proposé à la réservation.</p>
{{ m.recap([['Date', start|date_longue], ['Prestation', prestation ?? ''], ['Remboursement', refundable ? 'Paiement en ligne remboursé automatiquement' : (avoirCents is defined and avoirCents > 0 ? 'Annulation tardive : ' ~ avoirCents|euros ~ ' gardés en avoir pour son prochain rendez-vous' : 'Annulation tardive : rien n’est remboursé')]]) }}
{% endblock %}
