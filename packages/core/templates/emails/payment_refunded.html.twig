{% extends '_base.html.twig' %}
{% import '_macros.html.twig' as m %}
{% block subject %}Remboursement de {{ amountCents|euros }}{% endblock %}
{% block preheader %}Votre remboursement est en cours.{% endblock %}
{% block titre %}Votre remboursement est en cours{% endblock %}
{% block body %}
<p style="margin:0 0 8px;">Bonjour {{ firstname }},</p>
{% if reason == 'creneau_indisponible' %}<p style="margin:0 0 8px;">Votre paiement est arrivé après la fin du délai de réservation, et le créneau a été pris entre-temps. J’en suis désolé.</p>{% endif %}
{{ m.recap([['Montant remboursé', amountCents|euros], ['Délai', 'Quelques jours, selon votre banque']]) }}
<p style="margin:0;font-size:14px;color:#4b5563;">Le remboursement est fait sur le moyen de paiement utilisé.</p>
{% endblock %}
