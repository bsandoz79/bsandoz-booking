{% extends '_base.html.twig' %}
{% import '_macros.html.twig' as m %}
{% block subject %}Nouveau rendez-vous : {{ client }}, {{ start|jour_long }}{% endblock %}
{% block preheader %}{{ prestation ?: 'Rendez-vous' }} le {{ start|date_longue }}.{% endblock %}
{% block titre %}Nouveau rendez-vous{% endblock %}
{% block body %}
{% set paiement = enLigneCents is defined
    ? (enLigneCents > 0 ? (surPlaceCents > 0 ? 'Réglé en ligne : ' ~ enLigneCents|euros ~ ' · sur place : ' ~ surPlaceCents|euros : 'Tout est réglé en ligne (' ~ enLigneCents|euros ~ ')') : 'Sur place, une fois la prestation terminée (' ~ surPlaceCents|euros ~ ')')
    : (depositCents is defined and depositCents > 0 ? 'Acompte réglé : ' ~ depositCents|euros ~ ', solde sur place' : '') %}
{{ m.recap([['Date', start|date_longue], ['Prestation', prestation ?? ''], ['Client', client], ['Téléphone', phone ?? ''], ['Adresse', address ?? ''], ['Total', totalCents|euros], ['Paiement', paiement], ['Précisions', notes ?? '']]) }}
{{ m.bouton(front_url ~ '/pro', 'Ouvrir mon planning') }}
{% endblock %}
