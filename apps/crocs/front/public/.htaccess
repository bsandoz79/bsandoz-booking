# Site de Croc's (o2switch, crocs.demo.bsandoz.fr) : HTTPS obligatoire, démo privée non indexée.
RewriteEngine On
RewriteBase /

# Manifeste de l'appli de l'espace pro.
AddType application/manifest+json .webmanifest

RewriteCond %{HTTPS} off
RewriteCond %{HTTP:X-Forwarded-Proto} !https
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Espace du patron (/pro) et mentions légales : même application, servie par index.html.
RewriteRule ^(pro|mentions-legales)/?$ index.html [L]

<IfModule mod_headers.c>
  # Démo privée : les moteurs de recherche ne l'indexent pas (en plus de la balise robots de index.html).
  Header always set X-Robots-Tag "noindex, nofollow"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "DENY"
  <FilesMatch "\.(html|webmanifest)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  # Fichiers du build (nom avec empreinte) : cache d'un an.
  <If "%{REQUEST_URI} =~ m#^/assets/#">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>
  # Photos (déposées sur le serveur, nom fixe) : cache d'une journée, pour qu'une photo changée se voie vite.
  <If "%{REQUEST_URI} =~ m#^/photos/#">
    Header set Cache-Control "public, max-age=86400"
  </If>
</IfModule>
